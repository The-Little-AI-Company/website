---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Lane from '../components/Lane.astro';
import Lanes from '../components/Lanes.astro';
import NowLine from '../components/NowLine.astro';
import Plate from '../components/Plate.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import SpecPlate from '../components/SpecPlate.astro';
import SplitSection from '../components/SplitSection.astro';
import { projects } from '../data/projects';
import { callout, calloutPlate, latestVersion, stampedStatus, vivary } from '../data/tools';
import type { Term } from '../data/types';

const version = await latestVersion(callout.version);
const calloutStatus = await stampedStatus(callout);

const tenets: Term[] = [
  { term: 'You decide', detail: 'The tool proposes and you approve. A human gate is a feature, not a speed bump.' },
  { term: 'You can\u00a0read everything', detail: 'State is plain files on a machine you control, not a hosted store you cannot open.' },
  { term: 'You keep learning', detail: 'A tool that thinks for you leaves you weaker. These tools show their work so you get sharper.' },
  { term: 'Sources or silence', detail: 'Every claim carries where it came from. Unsure is a real answer.' },
];
---

<Base
  title="The Little AI Company"
  description="The Little AI Company makes Callout, which checks what you read, and Vivary, a desktop workspace for AI agents. Both keep you in charge."
>
  <section class="hero">
    <div class="wrap">
      <NowLine tone="wip">Vivary {vivary.prerelease.tag.slice(1)} is out for Windows. Published {vivary.prerelease.date}.</NowLine>
      <h1 class="display-xl">Tools for the work you keep doing by hand.</h1>
      <p class="lede">
        The Little AI Company makes Callout, a hotkey that checks what you read, and Vivary, a desktop
        workspace for AI agents. Small tools that keep you in charge of the AI you use.
      </p>
      <div class="actions">
        <Button href="/callout/#get-it" variant="primary">Get Callout</Button>
        <Button href="/vivary/">See Vivary</Button>
      </div>
      <picture class="mascot">
        <source media="(max-width: 860px)" srcset="/images/vivary-mascot-skate-640.webp" width="640" height="571" />
        <img
          src="/images/vivary-mascot-skate-760.webp"
          width="760"
          height="678"
          alt="The Vivary mascot, a felt creature with antlers, riding a skateboard with a paintbrush, a potted flower, and a notebook."
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </section>

  <section id="work" class="section work">
    <div class="wrap">
      <ProjectFeature
        numeral="I. The main project"
        title="Vivary"
        tone={vivary.tone}
        status={vivary.status}
        href="/vivary/"
        linkLabel="More about Vivary"
      >
        <Plate
          slot="media"
          src="/images/vivary-workspace-2026-10-03.webp"
          srcset="/images/vivary-workspace-2026-10-03-600.webp 600w, /images/vivary-workspace-2026-10-03.webp 1200w"
          width={1200}
          height={844}
          alt="The Vivary window: a project list and conversations in a sidebar, an empty chat headed “What are we working on?”, and a notice asking you to sign in to Claude Code."
        >
          <Fragment slot="caption">Development build, Oct 3, 2026, a month before <span class="nowrap">beta.1</span>.</Fragment>
        </Plate>
        <p class="text">
          A desktop workspace for working with AI agents on your own projects. Agent chat, project files, tools,
          and memory sit in one Windows app. For coding conversations it uses Claude Code or Codex, installed and
          signed in on the same computer. Vivary has no account of its own and includes no model
          access. <a class="nowrap" href={vivary.prerelease.href}>Release notes and download</a>.
        </p>
      </ProjectFeature>

      <ProjectFeature
        reverse
        numeral="II. Ready to download"
        title="Callout"
        tone={callout.tone}
        status={calloutStatus}
        href="/callout/"
        linkLabel="More about Callout"
      >
        <SpecPlate slot="media" {...calloutPlate(version)} />
        <p class="text">{callout.summary}</p>
      </ProjectFeature>
    </div>
  </section>

  <section id="other" class="section other">
    <div class="wrap">
      <h2 class="heading">Other projects</h2>
      <ol class="contents">
        {projects.map((project) => <ProjectEntry {...project} />)}
      </ol>
    </div>
  </section>

  <SplitSection id="how" heading="How the tools work">
    <p slot="intro" class="text how-intro">
      Memory in files you can open. Claims with the sources behind them. Nothing runs that you can’t see,
      stop, or undo.
    </p>
    <Lanes>
      {tenets.map(({ term, detail }) => <Lane term={term}>{detail}</Lane>)}
    </Lanes>
  </SplitSection>
</Base>

<style>
  /* Hero: centered, and the mascot stands on the hairline that opens the next section. */
  .hero {
    /* 36px at 360px and below, 88px at 860px and above, and a straight line between (the formula is in global.css). */
    padding-top: clamp(var(--space-6), 10.4vw - 1.44px, 88px);
    text-align: center;
  }

  .hero h1 {
    max-width: 12ch;
    margin: 24px auto 0;
  }

  .hero .lede {
    margin: 28px auto 0;
    text-wrap: balance;
  }

  .hero .actions {
    justify-content: center;
    margin-inline: auto;
  }

  /* 260px at 360px and below, 470px at 860px and above, and a straight line between (the formula is in global.css). */
  .mascot {
    display: block;
    width: clamp(260px, 42vw + 108.8px, 470px);
    max-width: 78%;
    /* The bottom margin pulls the next section up 3px, so the wheels stand on its top rule. */
    margin: 64px auto -3px;
  }

  .mascot img {
    width: 100%;
  }

  .work .wrap {
    display: grid;
    gap: var(--space-9);
  }

  /* Other things: a centered heading over a list that stops at 940px. */
  .other h2 {
    margin-bottom: 40px;
    text-align: center;
  }

  .other .contents {
    max-width: 940px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  /* The design system sets this one paragraph a point larger than body text. */
  .how-intro {
    font-size: 1.0625rem;
  }

  @media (max-width: 860px) {
    .hero h1 {
      margin-top: 18px;
    }

    .hero .lede {
      margin-top: var(--space-4);
    }

    .mascot {
      margin-top: var(--space-6);
    }

    .work .wrap {
      gap: var(--space-7);
    }

    .other h2 {
      margin-bottom: var(--space-5);
    }
  }
</style>
