---
import Base from '../layouts/Base.astro';
import Lane from '../components/Lane.astro';
import Lanes from '../components/Lanes.astro';
import Plate from '../components/Plate.astro';
import SplitSection from '../components/SplitSection.astro';
import ToolHero from '../components/ToolHero.astro';
import { vivary } from '../data/tools';

const { prerelease } = vivary;
---

<Base
  title="Vivary"
  description="A desktop workspace for AI agents on your own projects. Agent chat, project files, tools, and memory in one app. Windows first. Beta 0.1.0-beta.1 is out."
>
  <ToolHero tool={vivary}>
    <Plate
      src="/images/vivary-site-2026-10-08.webp"
      srcset="/images/vivary-site-2026-10-08-640.webp 640w, /images/vivary-site-2026-10-08.webp 1200w"
      alt="The vivaryagent.xyz home page: the headline “Your projects. Your AI agents.”, a Windows preview download button, and the felt antlered mascot holding a book."
      width={1200}
      height={750}
      eager
    >
      <Fragment slot="caption">vivaryagent.xyz, Oct 8, 2026.</Fragment>
    </Plate>
  </ToolHero>

  <SplitSection heading="What it is">
    <p slot="intro" class="text">
      One app where you open a project, talk to an agent about it, and watch what
      the agent does to your files. Vivary runs on your computer. Claude Code or
      Codex does the coding work and must be installed and signed in on the same computer.
    </p>
    <Lanes>
      <Lane term="Work on a project">
        Open an existing folder as a project, or create a new one. Chat with Claude
        Code or Codex in it. The agent can read files, change files, and run tools.
      </Lane>
      <Lane term="Keep what matters">
        Save project facts as readable files in the project, and search the
        project’s files.
      </Lane>
      <Lane term="Check project health">
        Run a project health check with the Python that ships inside the app.
      </Lane>
      <Lane term="Automate">
        Set up automations that run on a schedule, on an event, or from a webhook
        while Vivary is open. Provider-backed automations are not yet tested on the
        installed app.
      </Lane>
      <Lane term="Self-host later">
        Vivary is built to be self-hosted. Remote access from another device is not
        yet tested on the installed app, so beta.1 is a desktop release.
      </Lane>
    </Lanes>
  </SplitSection>

  <SplitSection heading="What it asks of you">
    <Lanes>
      <Lane term="No Vivary account">
        The desktop app needs none. Your Claude Code or Codex sign-in is yours and separate.
      </Lane>
      <Lane term="Windows 10 or 11, 64-bit">
        No administrator rights. The installer installs Vivary for your Windows account only.
      </Lane>
      <Lane term="Windows first">
        The desktop app targets Windows. A Mac build is possible later work, not a promise.
      </Lane>
    </Lanes>
  </SplitSection>

  <SplitSection heading="Status">
    <p class="lede">
      Beta. Version {prerelease.tag.slice(1)} was published on {prerelease.date} as a <a class="nowrap" href={prerelease.href}>GitHub prerelease</a>.
      It comes as an installer and as a portable ZIP, for Windows 10 and 11 (x64). Neither is code signed, so
      Windows can show “Windows protected your PC”. Select More info, then Run anyway. Each file has a checksum,
      and the release notes show how to check it. The <a class="nowrap" href={vivary.queue}>release queue</a> lists
      what is verified and what is still required, in the open. Open source under MIT.
    </p>
    <p class="text later">
      Known limits: Vivary runs one coding conversation at a time on a computer. Provider-backed automations,
      remote access from another device, and an upgrade over an earlier install are not yet tested on the
      installed app. Rolling back to an earlier version after an upgrade is not supported, so back up your
      Vivary data before you upgrade. The <a class="nowrap" href={prerelease.href}>release notes</a> list the rest.
    </p>
    <p class="text later">
      Found a bug? <a class="nowrap" href={`${vivary.repo}/issues/new`}>Open an issue</a>. Include the release tag,
      your Windows version, the steps, and the error text. Do not attach credentials or private conversations.
      More about the project is at <a class="nowrap" href="https://vivaryagent.xyz">vivaryagent.xyz</a>.
    </p>
  </SplitSection>
</Base>

<style>
  .later {
    margin-top: var(--space-5);
  }
</style>
